{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: List Images",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/yt_serve/dist_utils/build_image.py",
                "--list"
            ],
            "options": {
                "cwd": "${workspaceFolder}/yt_serve"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Docker: Build Test Image",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/yt_serve/dist_utils/build_image.py",
                "-e",
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}/yt_serve"
            },
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Docker: Run All Tests",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "yt_serve:test"
            ],
            "dependsOn": "Docker: Build Test Image",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Docker: Run Specific Test",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "yt_serve:test",
                "${input:testNamespace}"
            ],
            "dependsOn": "Docker: Build Test Image",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Docker: Build Dev Image",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/yt_serve/dist_utils/build_image.py",
                "-e",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/yt_serve"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Docker: Rollback to Previous Release",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/yt_serve/dist_utils/build_image.py",
                "--rollback"
            ],
            "options": {
                "cwd": "${workspaceFolder}/yt_serve"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Docker: Prune Old Images",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/yt_serve/dist_utils/build_image.py",
                "--prune"
            ],
            "options": {
                "cwd": "${workspaceFolder}/yt_serve"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "testNamespace",
            "type": "promptString",
            "description": "Enter test namespace (e.g. tests.test_logging_engine or tests.test_logging_engine.TestLoggingEngine.test_buffer_capacity_eviction):",
            "default": "tests.test_logging_engine"
        }
    ]
}
